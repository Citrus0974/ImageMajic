<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.image.majic.MainWindowController">
    <top>
        <MenuBar>
            <menus>
                <Menu text="_File">
                    <items>
                        <MenuItem accelerator="Shortcut+O" onAction="#onOpenImage" text="_Open image" />
                        <MenuItem accelerator="Shortcut+S" onAction="#onSaveImage" text="_Save image" />
                    </items>
                </Menu>
                <Menu text="_View">
                    <items>
                        <MenuItem accelerator="Shortcut+=" onAction="#onScalePlus" text="_Increase scale" />
                        <MenuItem accelerator="Shortcut+-" onAction="#onScaleMinus" text="_Decrease scale" />
                        <MenuItem onAction="#onScaleFit" text="_Fit to screen" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <ScrollPane fx:id="imageScrollPane" pannable="true" prefHeight="400.0" prefWidth="600.0" BorderPane.alignment="CENTER">
            <content>
                <ImageView fx:id="imageView" pickOnBounds="true" preserveRatio="true" />
            </content>
        </ScrollPane>
    </center>
    <left>
        <VBox prefWidth="300.0" spacing="10" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Scale" />
                <ButtonBar buttonMinWidth="0.0">
                    <buttons>
                        <Button onAction="#onScalePlus" text="+" />
                        <Button onAction="#onScaleMinus" text="-" />
                        <Button onAction="#onScaleFit" text="Fit" />
                    </buttons>
                </ButtonBar>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            </HBox>
        </VBox>
    </left>
    <right>
        <VBox prefWidth="300.0" BorderPane.alignment="CENTER">
            <children>
                <AreaChart fx:id="histogramChart" alternativeColumnFillVisible="true" horizontalGridLinesVisible="false" verticalGridLinesVisible="false"
                           alternativeRowFillVisible="false" createSymbols="false">
                    <xAxis>
                        <NumberAxis side="BOTTOM" tickLabelsVisible="false" tickMarkVisible="false" upperBound="255.0" autoRanging="false" tickUnit="50.0" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" tickLabelsVisible="false" tickMarkVisible="false" minorTickVisible="false"/>
                    </yAxis>
                </AreaChart>
                <ComboBox onAction="#onHistogramChannelChanged" fx:id="histogramChannelCombo" prefWidth="400.0">
               <VBox.margin>
                  <Insets bottom="30.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
                </ComboBox>
                <TableView prefHeight="200.0" prefWidth="200.0">
                    <columns>
                        <TableColumn prefWidth="75.0" text="C1" />
                        <TableColumn prefWidth="75.0" text="C2" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </right>
</BorderPane>
